# Thin AgentBox layer over the official Hermes image.
# Single public port: Caddy on 8080 serves the dashboard and proxies
# /v1/* + /health to the Hermes API server (localhost:18080).
#
# Build (AgentBox compute is x86_64):
#   docker buildx build --platform linux/amd64 \
#     --build-arg BASE_IMAGE=docker.io/nousresearch/hermes-agent:v2026.9.14 \
#     -t hermes-agentbox:latest -f Dockerfile.agentbox .
ARG BASE_IMAGE=docker.io/nousresearch/hermes-agent:v2026.9.14
FROM ${BASE_IMAGE}

# API server: bound to loopback only — Caddy fronts it on the public port.
ENV API_SERVER_ENABLED=true \
    API_SERVER_HOST=127.0.0.1 \
    API_SERVER_PORT=18080 \
    HERMES_DASHBOARD=1 \
    HERMES_DASHBOARD_PORT=9119

# Map GMI MaaS injection -> Hermes GMI provider, before the main service boots.
COPY --chmod=0755 gmi-maas-init /etc/cont-init.d/00-gmi-maas

# Single-port front + messaging/Tailscale tooling.
# Installed: caddy (front proxy), tailscale (private dashboard access via
# official install script — Debian has no tailscale package). jq dropped
# (not needed). Messaging clients ship in the base image; the gateway
# enables Telegram/Discord automatically when their token env vars are
# present — no extra packages needed.
RUN apt-get update \
    && apt-get install -y --no-install-recommends caddy curl gnupg \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://tailscale.com/install.sh | sh 2>/dev/null \
    && tailscale version
COPY Caddyfile /etc/caddy/Caddyfile
COPY --chmod=0755 caddy-start /etc/cont-init.d/01-caddy-start
COPY --chmod=0755 tailscale-start /etc/cont-init.d/02-tailscale-start

EXPOSE 8080
# main-wrapper.sh routes "gateway run" -> `hermes gateway run`
CMD ["gateway", "run"]
